<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>dev.gaphunter.refactorsimulator</id>
    <name>Refactor Simulator</name>
    <vendor>Gap Hunter Labs</vendor>
    <description><![CDATA[
        <p>Preview every refactoring before committing it. Simulates a rename or
        extract refactor in an isolated in-memory sandbox — using IntelliJ's own
        PSI and refactoring APIs, never a custom engine — and shows a full impact
        report, validation results, and a side-by-side diff before anything
        touches a real file.</p>
        <p>Unlike the native preview dialog, everything stays isolated until you
        explicitly choose Apply to Disk. Discard leaves the project exactly as it
        was — no exceptions.</p>
        <p>Free. No AI, no confidence scores, no probabilistic heuristics — every
        reported number comes directly from Find Usages and IntelliJ's own
        refactoring processors.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.java</depends>
    <depends>org.jetbrains.kotlin</depends>

    <!-- Freemium as of 0.3.0: PRODUCT_CODE assigned by JetBrains 2026-08-06
         after enrolling in Marketplace Monetization. optional="true" means
         the plugin still installs and works fully for free; only
         "Will run" on a Related Test is gated, via
         RefactorSimulatorLicense.isLicensed(). release-version must parse
         as an integer with at least two digits (confirmed live: "03"
         fails verifyPlugin with "format is invalid... at least two
         digits" because the leading zero doesn't survive integer
         parsing) while still matching the plugin version's own leading
         digits; "003" keeps the same digit order as "0.3.0" (0, then
         3) but padded to a width the parser can't collapse to a single
         digit. Stays fixed as long as the plugin version starts with
         "0.3", never touched again after this first release under it,
         same discipline as
         ansible-companion/api-security-companion/openapi-companion (see
         INTELLIJ_PLATFORM_KNOWLEDGE.md, section 4.2). -->
    <product-descriptor code="PREFACTORSIMULA" release-date="20260806" release-version="003" optional="true"/>

    <actions>
        <group id="RefactorSimulator.Actions" text="Refactor Simulator" popup="true">
            <action id="RefactorSimulator.Simulate"
                    class="dev.gaphunter.refactorsimulator.actions.SimulateRefactorAction"
                    text="Simulate Refactor..."
                    description="Simulates a rename/extract refactor in an isolated sandbox, with a visual diff and impact report, before touching any real file"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="RefactoringMenu" anchor="last"/>
        </group>
    </actions>

    <extensions defaultExtensionNs="com.intellij">
        <applicationConfigurable
            parentId="tools"
            instance="dev.gaphunter.refactorsimulator.settings.RefactorSimulatorConfigurable"
            id="dev.gaphunter.refactorsimulator.settings.RefactorSimulatorConfigurable"
            displayName="Refactor Simulator"/>
        <toolWindow id="Refactor Simulator"
                    anchor="right"
                    factoryClass="dev.gaphunter.refactorsimulator.ui.ImpactToolWindowFactory"/>
    </extensions>

    <!-- Without this, the whole plugin silently fails to load under the Kotlin
         plugin's K2 mode (the default since 2024.x), caught by a real runIde
         run logging "incompatible with Kotlin in K2 mode", not by inspection.
         Safe to support both: nothing here calls a resolve/analysis API that
         differs between K1 and K2. RefactorSimulationRunner only drives
         RenameProcessor/RenameUtil/findUsages(), all platform refactoring APIs,
         not Kotlin-plugin-internal ones. Same gotcha already documented in
         highlight-companion's plugin.xml. -->
    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK1="true" supportsK2="true"/>
    </extensions>
</idea-plugin>
